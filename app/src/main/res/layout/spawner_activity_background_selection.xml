<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <!--android:background="@color/purple_200"-->

    <RelativeLayout
        android:id="@+id/rl_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btm"
        android:background="@color/white">

    <LinearLayout
        android:id="@+id/top_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <View
            android:id="@+id/status_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/ic_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="12dp"
                android:padding="2dp"
                android:src="@drawable/spawner_ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/select_bg"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:visibility="visible" />

        </RelativeLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/viewPagerLay"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_below="@+id/top_ly">

        <com.festival.flyer.postermaker.view.MailER_PagerSlidingTabStrip
            android:id="@+id/pagerSlidingTabStrip"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:pstsDividerColor="@color/white"
            app:pstsIndicatorColor="@color/new_selected"
            app:pstsShouldExpand="true"
            app:pstsTabBackground="@color/transparent"
            app:pstsTextAllCaps="false"
            app:pstsUnderlineColor="@color/transparent" />
    </RelativeLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/bottom_ly"
        android:layout_below="@+id/viewPagerLay" />

    <LinearLayout
        android:id="@+id/bottom_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_50sdp"
        android:layout_alignParentBottom="true"
        android:background="#E6E6E6"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="start">

            <ImageView
                android:id="@+id/ic_gallery"
                android:layout_width="57dp"
                android:layout_height="57dp"
                android:layout_gravity="center"
                android:padding="@dimen/_11sdp"
                android:src="@drawable/spawner_image_press" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end">

            <ImageView
                android:id="@+id/ic_color"
                android:layout_width="57dp"
                android:layout_height="57dp"
                android:layout_gravity="center"
                android:padding="@dimen/_11sdp"
                android:src="@drawable/spawner_color_unpress"
                app:tint="@color/new_selected" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/camera_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_25sdp"
        android:gravity="center">

        <ImageView
            android:id="@+id/ic_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/spawner_camera_unpress" />
    </LinearLayout>
</RelativeLayout>
    <RelativeLayout
        android:id="@+id/btm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:visibility="gone"
        android:layout_alignParentBottom="true">

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            tools:visibility="visible"/>


        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:shimmer_auto_start="true">

            <TextView
                android:id="@+id/yourTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Ad Loading...."
                android:textSize="20sp" />

        </com.facebook.shimmer.ShimmerFrameLayout>

    </RelativeLayout>
</RelativeLayout>