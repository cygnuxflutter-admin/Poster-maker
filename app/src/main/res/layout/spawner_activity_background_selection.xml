<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="#FAFAFA">

    <RelativeLayout
        android:id="@+id/rl_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btm"
        android:background="#FAFAFA">

        <LinearLayout
            android:id="@+id/top_ly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FAFAFA">

            <View
                android:id="@+id/status_bar_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_4sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/ll_pro_toggle"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ic_back"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/spawner_ic_chevron_left_new"
                        app:tint="#381079" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/_2sdp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/spawner_visbyroundcf_bold"
                                android:text="@string/select_bg"
                                android:textColor="#381079"
                                android:textSize="@dimen/_18ssp"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:src="@drawable/spawner_ic_sparkle"
                                app:tint="#381079" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/spawner_visbyroundcf_medium"
                            android:text="Choose the background"
                            android:textColor="#9E9E9E"
                            android:textSize="@dimen/_9ssp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_pro_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:background="@drawable/spawner_tab_pill_background"
                    android:backgroundTint="#FF8C00"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/spawner_ic_crown"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold"
                        android:text="PRO"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Categories -->
        <RelativeLayout
            android:id="@+id/viewPagerLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/top_ly"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_category_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_40sdp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:clipToPadding="false"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp" />
        </RelativeLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/viewPagerLay"
            android:layout_marginBottom="0dp" />

        <RelativeLayout
            android:id="@+id/bottom_ly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:visibility="gone"
            android:layout_alignParentBottom="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_54sdp"
                android:background="@drawable/spawner_bg_floating_bar"
                android:elevation="@dimen/_8sdp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">
                
                <LinearLayout
                    android:id="@+id/ic_gallery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingEnd="@dimen/_32sdp"
                    android:orientation="vertical">
                    
                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/spawner_image_press"
                        app:tint="#8A2BE2" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textSize="@dimen/_10ssp"
                        android:textColor="#8A2BE2"
                        android:text="Gallery"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ic_color"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/_32sdp"
                    android:orientation="vertical">
                    
                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/spawner_color_unpress"
                        app:tint="#8A2BE2" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textSize="@dimen/_10ssp"
                        android:textColor="#8A2BE2"
                        android:text="Colors"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Floating Camera Button (moved to Create screen) -->
        <LinearLayout
            android:id="@+id/camera_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_22sdp"
            android:elevation="@dimen/_12sdp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ic_camera"
                android:layout_width="@dimen/_54sdp"
                android:layout_height="@dimen/_54sdp"
                android:padding="@dimen/_14sdp"
                android:background="@drawable/spawner_bg_camera_circle_with_border"
                android:src="@drawable/spawner_ic_camera_white" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/btm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_above="@+id/bottom_nav_bar">

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            tools:visibility="visible"/>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            app:shimmer_auto_start="true">

            <TextView
                android:id="@+id/yourTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Ad Loading...."
                android:textSize="@dimen/_20ssp" />

        </com.facebook.shimmer.ShimmerFrameLayout>

    </RelativeLayout>
    
    <include layout="@layout/spawner_bottom_nav_bar" />
</RelativeLayout>