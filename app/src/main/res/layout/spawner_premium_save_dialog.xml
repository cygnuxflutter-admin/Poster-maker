<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="@dimen/_6sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_20sdp"
            android:paddingBottom="@dimen/_18sdp">

            <!-- Top Sparkle Icon Circle -->
            <FrameLayout
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:background="@drawable/spawner_bg_reward_icon_circle">

                <ImageView
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/spawner_ic_sparkle"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Dialog Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:gravity="center"
                android:text="Watermark Removed!"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <!-- Dialog Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/spawner_visbyroundcf_medium"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Your clean HD poster has been saved to Gallery successfully."
                android:textColor="#6B7280"
                android:textSize="@dimen/_12ssp" />

            <!-- OK Button -->
            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/spawner_btn_rounded_text_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="OK"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>