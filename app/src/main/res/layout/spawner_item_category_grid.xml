<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_tab_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp"
    android:background="@drawable/spawner_tab_pill_selector"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_tab_thumbnail"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_tab_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        android:textSize="@dimen/_24ssp" />

    <TextView
        android:id="@+id/tv_tab_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/spawner_visbyroundcf_bold"
        android:gravity="center"
        android:textColor="#21005D"
        android:textSize="@dimen/_11ssp"
        android:maxLines="2"
        android:minLines="2"
        android:ellipsize="end" />
</LinearLayout>
