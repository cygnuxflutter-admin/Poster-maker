<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    tools:context=".activities.MailER_CreateActivity">

    <!-- Header with Back Button (same as Select Poster page) -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_4sdp"
            android:padding="@dimen/_12sdp"
            android:src="@drawable/spawner_ic_chevron_left_new"
            app:tint="#381079" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Create"
            android:textColor="#381079"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav_bar"
        android:layout_below="@+id/header"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_20sdp"
            android:paddingBottom="@dimen/_12sdp">

            <!-- Title Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create "
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_20ssp"
                            android:fontFamily="@font/spawner_visbyroundcf_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Something Amazing"
                            android:textColor="#7B2FF7"
                            android:textSize="@dimen/_20ssp"
                            android:fontFamily="@font/spawner_visbyroundcf_bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="Choose how you want to create your design"
                        android:textColor="#888888"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ===== Gallery Card ===== -->
            <LinearLayout
                android:id="@+id/btn_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/spawner_bg_card_gallery"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <!-- Icon -->
                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/spawner_image_press"
                    app:tint="#7B2FF7"
                    android:padding="@dimen/_8sdp" />

                <!-- Texts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gallery"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_16ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="Pick images from your gallery and use in your design"
                        android:textColor="#666666"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="Choose from photos"
                        android:textColor="#7B2FF7"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />
                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/spawner_bg_circle_white"
                    android:src="@drawable/spawner_ic_arrow_right"
                    android:padding="@dimen/_8sdp"
                    app:tint="#7B2FF7" />
            </LinearLayout>

            <!-- ===== Camera Card ===== -->
            <LinearLayout
                android:id="@+id/btn_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/spawner_bg_card_camera"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/spawner_ic_camera_white_vector"
                    app:tint="#3B82F6"
                    android:padding="@dimen/_8sdp" />

                <!-- Texts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camera"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_16ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="Take a new photo and bring your ideas to life"
                        android:textColor="#666666"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="Capture now"
                        android:textColor="#3B82F6"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />
                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/spawner_bg_circle_white"
                    android:src="@drawable/spawner_ic_arrow_right"
                    android:padding="@dimen/_8sdp"
                    app:tint="#3B82F6" />
            </LinearLayout>

            <!-- ===== Colors Card ===== -->
            <LinearLayout
                android:id="@+id/btn_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/spawner_bg_card_colors"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <!-- Icon -->
                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/spawner_color_unpress"
                    app:tint="#E040A0"
                    android:padding="@dimen/_8sdp" />

                <!-- Texts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colors"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_16ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="Choose colors or gradients to create beautiful backgrounds"
                        android:textColor="#666666"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="Pick your favorite colors"
                        android:textColor="#E040A0"
                        android:textSize="@dimen/_10ssp"
                        android:fontFamily="@font/spawner_visbyroundcf_bold" />
                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/spawner_bg_circle_white"
                    android:src="@drawable/spawner_ic_arrow_right"
                    android:padding="@dimen/_8sdp"
                    app:tint="#E040A0" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <!-- ==================== PREMIUM FLOATING BOTTOM NAV (Same as Home) ==================== -->
    <RelativeLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_72sdp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/spawner_bg_bottom_nav"
        android:elevation="@dimen/_16sdp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:clipChildren="false"
        android:clipToPadding="false">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- Home Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_home"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Home"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Explore Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tab_explore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_explore"
                    android:contentDescription="Explore" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Explore"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Center FAB Container (Active - this is the Create page) -->
            <LinearLayout
                android:id="@+id/tab_create"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:layout_width="@dimen/_46sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:background="@drawable/spawner_bg_fab_gradient"
                    android:elevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_26ssp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-light" />
                </RelativeLayout>
            </LinearLayout>

            <!-- My Creations Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tab_creations"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_creations"
                    android:contentDescription="My Creations" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Creations"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Settings Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_settings_gear"
                    android:contentDescription="Settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Settings"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
