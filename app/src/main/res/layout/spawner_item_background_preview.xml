<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false">

    <!-- Centered Direct Background Card Container with full-width dynamic ratio sizing (no side white space) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <ProgressBar
                android:id="@+id/pb_bg_loading"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/accent_purple"
                android:visibility="visible" />

            <!-- PRO / AD Badge on Top-Left -->
            <TextView
                android:id="@+id/iv_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/spawner_tab_pill_background"
                android:backgroundTint="#FF8C00"
                android:drawableStart="@drawable/spawner_ic_crown"
                android:drawablePadding="@dimen/_4sdp"
                android:drawableTint="@color/white"
                android:elevation="6dp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:text="PRO"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Like Heart Button on Top-Right -->
            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/spawner_bg_circle_white"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/spawner_ic_heart_outline"
                android:visibility="gone" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
