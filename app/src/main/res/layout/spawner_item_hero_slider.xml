<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hero_banner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/_180sdp"
    android:layout_marginHorizontal="@dimen/_16sdp"
    android:layout_marginTop="@dimen/_8sdp"
    android:background="@drawable/spawner_bg_hero_banner"
    android:clipToPadding="false"
    android:elevation="0dp"
    android:paddingVertical="@dimen/_24sdp">

    <!-- Background Sparkle decorations -->
    <ImageView
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/_24sdp"
        android:src="@drawable/spawner_ic_sparkle"
        android:alpha="0.4"
        android:contentDescription="Sparkle" />

    <ImageView
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_8sdp"
        android:src="@drawable/spawner_ic_sparkle"
        android:alpha="0.6"
        android:contentDescription="Sparkle" />

    <!-- Hero Illustration on the right -->
    <ImageView
        android:id="@+id/hero_illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/_16sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/picture"
        android:contentDescription="Illustration" />

    <!-- Banner Text Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/hero_illustration"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/_24sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poster\nMaker"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_24ssp"
            android:lineSpacingExtra="-4dp"
            android:fontFamily="@font/spawner_visbyroundcf_bold" />

        <TextView
            android:id="@+id/hero_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Design your festival posters in minutes with ease"
            android:textColor="#E0E0E0"
            android:textSize="@dimen/_11ssp"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="@font/spawner_visbyroundcf_medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
