<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:clipChildren="false"
    android:keepScreenOn="true"
    >

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/bottom_nav_bar"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_40sdp">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:padding="@dimen/_12sdp"
                    android:src="@drawable/spawner_ic_chevron_left_new"
                    app:tint="#381079"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/spawner_visbyroundcf_bold"
                    android:text="Settings"
                    android:textColor="#381079"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- My Activity Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Activity"
                android:textColor="#8E24AA"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_8sdp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_liked_backgrounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/spawner_bg_chip_purple_gradient"
                                android:src="@drawable/spawner_ic_heart_filled"
                                android:padding="@dimen/_8sdp"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Liked Backgrounds"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View your liked backgrounds"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_liked_templates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/spawner_bg_chip_purple_gradient"
                                android:src="@drawable/spawner_ic_apps"
                                android:padding="@dimen/_8sdp"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Liked Templates"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View your liked posters"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- App Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App"
                android:textColor="#8E24AA"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_8sdp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Share App -->
                    <LinearLayout
                        android:id="@+id/ll_share_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F3E5F5">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/_8sdp"
                                android:src="@drawable/spawner_ic_share_app"
                                app:tint="#8E24AA" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Share App"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Share Poster Maker with your friends"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                    <!-- Rate App -->
                    <LinearLayout
                        android:id="@+id/ll_rate_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FCE4EC">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/_8sdp"
                                android:src="@drawable/spawner_ic_rate_app"
                                app:tint="#D81B60" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate App"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate us on the Play Store"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                    <!-- Instagram -->
                    <LinearLayout
                        android:id="@+id/ll_instagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/spawner_bg_chip_orange"
                                android:src="@drawable/spawner_instagram_logo_icon"
                                android:padding="@dimen/_8sdp"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Instagram / Follow Us"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Follow us on Instagram"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Legal Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legal"
                android:textColor="#8E24AA"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_8sdp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Privacy Policy -->
                    <LinearLayout
                        android:id="@+id/ll_privacy_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E3F2FD">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/_8sdp"
                                android:src="@drawable/spawner_privacy_policy"
                                app:tint="#1565C0" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Privacy Policy"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Read our privacy policy"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                    </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Other Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:textColor="#8E24AA"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_8sdp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Help & Support -->
                    <LinearLayout
                        android:id="@+id/ll_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF8E1">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/_8sdp"
                                android:src="@android:drawable/ic_menu_help"
                                app:tint="#F9A825" />
                        </androidx.cardview.widget.CardView>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_12sdp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Help &amp; Support"
                                android:textColor="#1E1E1E"
                                android:textSize="@dimen/_12ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get help and support"
                                android:textColor="#9E9E9E"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/spawner_ic_arrow_right"
                            app:tint="#BDBDBD" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>


    <!-- ==================== PREMIUM FLOATING BOTTOM NAV ==================== -->
    <RelativeLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_72sdp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/spawner_bg_bottom_nav"
        android:elevation="@dimen/_16sdp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:clipChildren="false"
        android:clipToPadding="false">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- Home Tab -->
            <LinearLayout
                android:id="@+id/tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ic_tab_home"
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_home"
                    android:contentDescription="Home" />

                <TextView
                    android:id="@+id/txt_tab_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Home"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Explore Tab -->
            <LinearLayout
                android:id="@+id/tab_explore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ic_tab_explore"
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_explore"
                    android:contentDescription="Explore" />

                <TextView
                    android:id="@+id/txt_tab_explore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Explore"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Center FAB Container -->
            <LinearLayout
                android:id="@+id/tab_create"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:layout_width="@dimen/_46sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:background="@drawable/spawner_bg_fab_gradient"
                    android:elevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_26ssp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-light" />
                </RelativeLayout>
            </LinearLayout>

            <!-- My Creations Tab -->
            <LinearLayout
                android:id="@+id/tab_creations"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ic_tab_creations"
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/spawner_ic_creations"
                    android:contentDescription="My Creations" />

                <TextView
                    android:id="@+id/txt_tab_creations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="Creations"
                    android:textColor="@color/bottom_nav_inactive"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/spawner_visbyroundcf_medium" />
            </LinearLayout>

            <!-- Settings Tab -->
            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
