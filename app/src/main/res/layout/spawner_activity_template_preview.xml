<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_alignParentTop="true"
        android:background="@color/white"
        android:elevation="4dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_12sdp"
            android:src="@drawable/spawner_ic_chevron_left_new"
            app:tint="#381079" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/ic_back"
            android:layout_toStartOf="@+id/btn_edit_top"
            android:layout_marginEnd="@dimen/_8sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:maxLines="1"
                android:text="Templates"
                android:textColor="#381079"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/spawner_visbyroundcf_medium"
                android:maxLines="1"
                android:text="Template 1 of 1"
                android:textColor="#9E9E9E"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>

        <!-- Top Right Edit Button -->
        <LinearLayout
            android:id="@+id/btn_edit_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/spawner_bg_gradient_button"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_6sdp">

            <ImageView
                android:id="@+id/iv_edit_icon"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:src="@drawable/spawner_ic_edit_white"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_edit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:text="Edit"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pb_edit_loading"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Main ViewPager2 for Vertical Poster Browsing -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btm"
        android:layout_below="@+id/top_toolbar"
        android:background="#F5F6F9" />

    <!-- Swipe Up Hint Pill -->
    <LinearLayout
        android:id="@+id/lyt_swipe_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btm"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/spawner_bg_swipe_hint"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_5sdp">

        <ImageView
            android:id="@+id/iv_swipe_arrow"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/spawner_ic_chevron_up"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:fontFamily="@font/spawner_visbyroundcf_bold"
            android:text="Swipe up for more"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>

    <!-- Bottom Banner Ad Layout -->
    <RelativeLayout
        android:id="@+id/btm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E0E0E0"
        android:visibility="gone">

        <View
            android:id="@+id/banner_sep"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"
            android:background="#D0D0D0" />

        <View
            android:id="@+id/banner_space"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_below="@id/banner_sep"
            android:background="#F5F5F5" />

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/banner_space"
            android:visibility="visible"
            tools:visibility="visible" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_below="@id/banner_space"
            app:shimmer_auto_start="true">

            <TextView
                android:id="@+id/yourTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Ad Loading...."
                android:textSize="@dimen/_20ssp" />

        </com.facebook.shimmer.ShimmerFrameLayout>

    </RelativeLayout>

</RelativeLayout>
