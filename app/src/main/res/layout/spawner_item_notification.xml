<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:layout_marginVertical="@dimen/_4sdp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/spawner_ic_notification"
            android:background="@drawable/spawner_circle_bg"
            android:padding="@dimen/_6sdp"
            app:tint="@color/hero_start"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_12sdp">

            <TextView
                android:id="@+id/tv_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold" />

            <TextView
                android:id="@+id/tv_notif_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="This is the notification body message."
                android:textColor="#757575"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/spawner_visbyroundcf_medium" />
                
            <TextView
                android:id="@+id/tv_notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="Just now"
                android:textColor="#BDBDBD"
                android:textSize="@dimen/_9ssp"
                android:fontFamily="@font/spawner_visbyroundcf_medium" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
