<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ic_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/spawner_bg_light_purple_button"
                    android:src="@drawable/spawner_ic_chevron_left_new"
                    android:padding="10dp"
                    app:tint="#100A30" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_centerInParent="true"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Profile"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#100A30" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add your business details once.\nWe'll use them to create personalized posters."
                        android:textSize="10sp"
                        android:textAlignment="center"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Logo Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <RelativeLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/spawner_bg_dashed_border"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/iv_business_logo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                android:padding="20dp"
                                app:tint="#8B5CF6"/>
                        </LinearLayout>
                        
                        <ImageView
                            android:id="@+id/iv_clear_logo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_margin="4dp"
                            android:src="@drawable/spawner_ic_close"
                            android:background="@drawable/bg_circle_purple"
                            android:padding="6dp"
                            app:tint="#FFFFFF"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Business Logo"
                            android:textStyle="bold"
                            android:textColor="#100A30"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add your logo (PNG, JPG)"
                            android:textColor="#6B7280"
                            android:textSize="10sp"
                            android:layout_marginBottom="8dp"/>

                                                <TextView
                            android:id="@+id/tv_use_default_logo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Don't have a logo? Use Default"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/spawner_bg_rounded_purple"
                            android:textSize="10sp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Name -->
            <include layout="@layout/spawner_item_profile_field" android:id="@+id/card_name" />
            <!-- Phone -->
            <include layout="@layout/spawner_item_profile_field" android:id="@+id/card_phone" />
            <!-- Address -->
            <include layout="@layout/spawner_item_profile_field" android:id="@+id/card_address" />
            
            

            <Button
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/spawner_bg_gradient_button"
                android:text="SAVE PROFILE →"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btn_next_poster"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/spawner_bg_light_purple_button"
                android:text="GENERATE BRAND POSTER →"
                android:textColor="#8B5CF6"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" 
                app:backgroundTint="@null"/>

            <!-- Bottom info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F3FF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="24sp"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Why add business details?"
                            android:textStyle="bold"
                            android:textColor="#5A32FA"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="We'll automatically add your logo, name, phone, address and more to your selected templates."
                            android:textColor="#6B7280"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
