<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="@dimen/_8sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingTop="@dimen/_20sdp"
            android:paddingBottom="@dimen/_18sdp">

            <!-- Circular Play / Reward Icon -->
            <FrameLayout
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:background="@drawable/spawner_bg_reward_icon_circle"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/spawner_ic_play_video_white"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Dialog Title -->
            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:gravity="center"
                android:text="Continue Editing"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <!-- Dialog Subtitle / Description -->
            <TextView
                android:id="@+id/tv_dialog_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/spawner_visbyroundcf_medium"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Watch a short video ad to unlock and continue editing your poster."
                android:textColor="#6B7280"
                android:textSize="@dimen/_12ssp" />

            <!-- Action Buttons (Styled to match the rest of the app's dialogs) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:orientation="horizontal">

                <!-- Cancel / Exit Button -->
                <TextView
                    android:id="@+id/btn_dialog_cancel"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:background="@drawable/spawner_btn_rounded_text_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/spawner_visbyroundcf_bold"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Exit"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

                <!-- Watch Ad / Continue Button -->
                <TextView
                    android:id="@+id/btn_dialog_watch"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:background="@drawable/spawner_btn_rounded_text_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/spawner_visbyroundcf_bold"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Watch Ad"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
