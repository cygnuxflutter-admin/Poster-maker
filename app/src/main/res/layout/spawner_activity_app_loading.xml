<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Animation Area: Creative Studio Canvas + Magic Pencil Drawing + Sparkles -->
    <LinearLayout
        android:id="@+id/layout_animation_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp">

        <!-- Stage Container for Mini Poster Canvas, Glow Aura, Pencil & Sparkles -->
        <FrameLayout
            android:id="@+id/stage_pencil_canvas"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="@dimen/_170sdp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Soft Radial Background Glow Aura -->
            <View
                android:id="@+id/iv_canvas_glow"
                android:layout_width="@dimen/_175sdp"
                android:layout_height="@dimen/_175sdp"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:background="@drawable/spawner_bg_canvas_glow" />

            <!-- Dashed Sketch Outline Card (The drawing frame) -->
            <View
                android:id="@+id/view_canvas_sketch_outline"
                android:layout_width="@dimen/_105sdp"
                android:layout_height="@dimen/_138sdp"
                android:layout_gravity="center"
                android:alpha="0.8"
                android:background="@drawable/spawner_bg_canvas_outline" />

            <!-- Mini Poster Artwork Card (The Masterpiece that reveals) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_poster_artwork"
                android:layout_width="@dimen/_105sdp"
                android:layout_height="@dimen/_138sdp"
                android:layout_gravity="center"
                android:alpha="0"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="@dimen/_6sdp">

                <!-- Vibrant Poster Design Layout -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/spawner_bg_mini_poster"
                    android:padding="@dimen/_8sdp">

                    <!-- Top Mini Badge -->
                    <TextView
                        android:id="@+id/tv_mini_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/spawner_bg_floating_pill"
                        android:fontFamily="@font/spawner_visbyroundcf_bold"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingVertical="@dimen/_2sdp"
                        android:text="✨ FESTIVAL SALE"
                        android:textColor="#E11D48"
                        android:textSize="@dimen/_6ssp" />

                    <!-- Center Festival Graphic / Diya Motif Card -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_mini_poster_icon"
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/spawner_app_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:fontFamily="@font/spawner_visbyroundcf_bold"
                            android:text="SHUBH DIWALI"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/spawner_visbyroundcf_medium"
                            android:text="FLAT 50% OFF"
                            android:textColor="#FDE047"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>

                    <!-- Bottom Mini Ribbon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/spawner_bg_tag_pill"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingVertical="@dimen/_2sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/spawner_visbyroundcf_bold"
                            android:text="POSTER MAKER"
                            android:textColor="#7C3AED"
                            android:textSize="@dimen/_6ssp" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Floating Sparkle 1 (Top-Right) -->
            <ImageView
                android:id="@+id/iv_sparkle_1"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:alpha="0"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/spawner_ic_sparkle"
                app:tint="#FBBF24" />

            <!-- Floating Sparkle 2 (Top-Left) -->
            <ImageView
                android:id="@+id/iv_sparkle_2"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_22sdp"
                android:alpha="0"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/spawner_ic_sparkle"
                app:tint="#C084FC" />

            <!-- Floating Sparkle 3 (Bottom-Right) -->
            <ImageView
                android:id="@+id/iv_sparkle_3"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:alpha="0"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/spawner_ic_sparkle"
                app:tint="#EC4899" />

            <!-- Floating Sparkle 4 (Bottom-Left) -->
            <ImageView
                android:id="@+id/iv_sparkle_4"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:alpha="0"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/spawner_ic_sparkle"
                app:tint="#38BDF8" />

            <!-- The Magic Drawing Pencil -->
            <ImageView
                android:id="@+id/iv_drawing_pencil"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="center"
                android:elevation="@dimen/_12sdp"
                android:src="@drawable/spawner_ic_magic_pencil" />
        </FrameLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/spawner_visbyroundcf_bold"
            android:text="Crafting Your Studio"
            android:textAlignment="center"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_18ssp" />

        <!-- Subtitle / Tagline -->
        <TextView
            android:id="@+id/tv_app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/spawner_visbyroundcf_medium"
            android:text="AI Designer is sketching your workspace"
            android:textAlignment="center"
            android:textColor="#7C3AED"
            android:textSize="@dimen/_10ssp" />

    </LinearLayout>

    <!-- Progress Loader Section (Placed directly ABOVE the Native Ad) -->
    <LinearLayout
        android:id="@+id/layout_progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_10sdp">

        <!-- Status Message & Percentage Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_loading_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/spawner_visbyroundcf_medium"
                android:maxLines="1"
                android:text="Finding the best templates for you..."
                android:textColor="#475569"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/tv_loading_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:text="0%"
                android:textColor="#7C3AED"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <!-- Smooth Rounded Gradient Progress Bar -->
        <ProgressBar
            android:id="@+id/loading_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_7sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/spawner_bg_loading_progress" />
    </LinearLayout>

    <!-- Bottom Native Ad Container: Large / Video Native Ad -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_native_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="@dimen/_2sdp">

        <RelativeLayout
            android:id="@+id/rl_loading_native_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp">

            <!-- Real Native Ad View loaded here -->
            <RelativeLayout
                android:id="@+id/native_ad_container"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:minHeight="180dp"
                android:visibility="visible" />

            <!-- Shimmer Placeholder (Full Video/Media preview placeholder) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/native_shimmer_container"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:minHeight="180dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/_6sdp">

                    <!-- Shimmer Top Row: Icon + Headline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="#E2E8F0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="120dp"
                                android:layout_height="@dimen/_10sdp"
                                android:background="#E2E8F0" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="@dimen/_8sdp"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:background="#E2E8F0" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:background="#E2E8F0" />
                    </LinearLayout>

                    <!-- Shimmer Media View Box -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:background="#CBD5E1" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
