<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_24sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- Pulsing Icon Container -->
            <FrameLayout
                android:id="@+id/fl_icon_container"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/spawner_bg_loading_icon_circle"
                android:layout_marginBottom="@dimen/_14sdp">

                <ImageView
                    android:id="@+id/iv_loading_icon"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/spawner_ic_sparkle"
                    app:tint="#7B2CBF" />
            </FrameLayout>

            <!-- Headline -->
            <TextView
                android:id="@+id/tv_loading_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personalizing Your Experience"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_18ssp"
                android:fontFamily="@font/spawner_visbyroundcf_bold"
                android:textAlignment="center"
                android:layout_marginBottom="@dimen/_6sdp" />

            <!-- Dynamic Status Text -->
            <TextView
                android:id="@+id/tv_loading_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finding the best templates for you..."
                android:textColor="#7B2CBF"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/spawner_visbyroundcf_medium"
                android:textAlignment="center"
                android:layout_marginBottom="@dimen/_14sdp" />

            <!-- Smooth Visual Progress Bar (No percentage numbers) -->
            <ProgressBar
                android:id="@+id/loading_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/spawner_bg_loading_progress"
                android:layout_marginBottom="@dimen/_20sdp" />

            <!-- Native Ad Card Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="@dimen/_3sdp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="@dimen/_16sdp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_8sdp">

                    <RelativeLayout
                        android:id="@+id/native_ad_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/_200sdp"
                        android:visibility="visible" />

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/native_shimmer_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/_200sdp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/_8sdp">

                            <View
                                android:layout_width="@dimen/_120sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:background="@drawable/spawner_bg_skeleton_pill"
                                android:layout_marginBottom="@dimen/_10sdp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_130sdp"
                                android:background="@drawable/spawner_bg_skeleton_placeholder"
                                android:layout_marginBottom="@dimen/_10sdp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:background="@drawable/spawner_bg_skeleton_pill" />
                        </LinearLayout>
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Subtitle / Info -->
            <TextView
                android:id="@+id/tv_bottom_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Setting up your creative workspace..."
                android:textColor="#9E9E9E"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/spawner_visbyroundcf_medium" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
