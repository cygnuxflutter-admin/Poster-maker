<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/spawner_bg_card_white"
    android:padding="@dimen/_6sdp">

    <RelativeLayout
        android:id="@+id/parentLyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Left: App Icon / MediaView Container -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_8sdp">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Right: Call to action button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_30sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="@dimen/_65sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:background="@drawable/bg_onboarding_btn"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:text="INSTALL" />

        <!-- Center: Text details (Headline, Body, Ad badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/icon_container"
            android:layout_toStartOf="@id/ad_call_to_action"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_8sdp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Ad Badge -->
                <TextView
                    android:id="@+id/ad_attribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFCC66"
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:text="Ad"
                    android:textColor="#000000"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginEnd="@dimen/_4sdp" />

                <!-- Headline -->
                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ad Headline"
                    android:textColor="#1A1A2E"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Body Text -->
            <TextView
                android:id="@+id/ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ad Body Description"
                android:textColor="#6B7280"
                android:textSize="@dimen/_9ssp" />

        </LinearLayout>

    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
